# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. Cloud Run or Vercel domain).
APP_URL="MY_APP_URL"

# SSLCOMMERZ Payment Gateway Credentials (Bangladesh & International)
# Sandbox defaults: Store ID: "testbox", Password: "qwerty"
SSLCOMMERZ_STORE_ID="testbox"
SSLCOMMERZ_STORE_PASSWORD="qwerty"
SSLCOMMERZ_IS_LIVE="false"

# Admin Secret: Server-managed authorization passkey for publisher operations
ADMIN_API_KEY="aljabin_secure_admin_passkey_change_in_production"

# Transactional Email Gateway (Resend / SendGrid / SMTP)
EMAIL_PROVIDER_API_KEY="YOUR_EMAIL_API_KEY"
EMAIL_FROM="orders@aljabinpublications.com"
