rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprint: User Profile (PII isolated to owner)
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'penName',
          'email',
          'phone',
          'location',
          'bio',
          'website',
          'role',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid == request.auth.uid && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 320 &&
        data.role is string && data.role == 'customer' &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64 &&
        (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!data.keys().hasAny(['penName']) || (data.penName is string && data.penName.size() <= 120)) &&
        (!data.keys().hasAny(['phone']) || (data.phone is string && data.phone.size() <= 40)) &&
        (!data.keys().hasAny(['location']) || (data.location is string && data.location.size() <= 120)) &&
        (!data.keys().hasAny(['bio']) || (data.bio is string && data.bio.size() <= 500)) &&
        (!data.keys().hasAny(['website']) || (data.website is string && data.website.size() <= 256)) &&
        (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation Blueprint: Public Storefront Product (manuscriptContent excluded from public doc)
    function isValidProduct(data) {
      return data.keys().hasAll(['title', 'author', 'category', 'priceBDT', 'isPublished', 'ownerId', 'createdAt']) &&
        data.keys().hasOnly([
          'title',
          'slug',
          'subtitle',
          'description',
          'shortDescription',
          'author',
          'language',
          'category',
          'coverImage',
          'priceBDT',
          'priceUSD',
          'format',
          'fileSize',
          'pages',
          'isbn',
          'publishedYear',
          'keyTakeaways',
          'sampleChapters',
          'originalFileStoragePath',
          'previewFileStoragePath',
          'isPublished',
          'isFeatured',
          'isNewRelease',
          'ownerId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 180 &&
        data.author is string && data.author.size() > 0 && data.author.size() <= 120 &&
        data.category is string && data.category in ['Personal Growth', 'Mindset', 'Productivity', 'Fiction'] &&
        data.priceBDT is number && data.priceBDT >= 0 && data.priceBDT <= 100000 &&
        data.isPublished is bool &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64 &&
        (!data.keys().hasAny(['slug']) || (data.slug is string && data.slug.size() <= 200)) &&
        (!data.keys().hasAny(['subtitle']) || (data.subtitle is string && data.subtitle.size() <= 240)) &&
        (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 5000)) &&
        (!data.keys().hasAny(['shortDescription']) || (data.shortDescription is string && data.shortDescription.size() <= 600)) &&
        (!data.keys().hasAny(['language']) || (data.language is string && data.language.size() <= 60)) &&
        (!data.keys().hasAny(['coverImage']) || (data.coverImage is string && data.coverImage.size() <= 250000)) &&
        (!data.keys().hasAny(['priceUSD']) || (data.priceUSD is number && data.priceUSD >= 0 && data.priceUSD <= 5000)) &&
        (!data.keys().hasAny(['format']) || (data.format is string && data.format.size() <= 60)) &&
        (!data.keys().hasAny(['fileSize']) || (data.fileSize is string && data.fileSize.size() <= 40)) &&
        (!data.keys().hasAny(['pages']) || (data.pages is number && data.pages >= 0 && data.pages <= 10000)) &&
        (!data.keys().hasAny(['isbn']) || (data.isbn is string && data.isbn.size() <= 64)) &&
        (!data.keys().hasAny(['publishedYear']) || (data.publishedYear is number && data.publishedYear >= 1900 && data.publishedYear <= 2100)) &&
        (!data.keys().hasAny(['keyTakeaways']) || (data.keyTakeaways is list && data.keyTakeaways.size() <= 10 && (data.keyTakeaways.size() == 0 || data.keyTakeaways[0] is string))) &&
        (!data.keys().hasAny(['sampleChapters']) || (data.sampleChapters is list && data.sampleChapters.size() <= 5 && (data.sampleChapters.size() == 0 || data.sampleChapters[0] is map))) &&
        (!data.keys().hasAny(['originalFileStoragePath']) || (data.originalFileStoragePath is string && data.originalFileStoragePath.size() <= 256)) &&
        (!data.keys().hasAny(['previewFileStoragePath']) || (data.previewFileStoragePath is string && data.previewFileStoragePath.size() <= 256)) &&
        (!data.keys().hasAny(['isFeatured']) || data.isFeatured is bool) &&
        (!data.keys().hasAny(['isNewRelease']) || data.isNewRelease is bool) &&
        (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation Blueprint: Private Author Manuscript Subcollection
    function isValidPrivateManuscript(data) {
      return data.keys().hasAll(['ownerId', 'updatedAt']) &&
        data.keys().hasOnly([
          'ownerId',
          'manuscriptContent',
          'originalFileName',
          'hasUploadedPdf',
          'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
        data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64 &&
        (!data.keys().hasAny(['manuscriptContent']) || (data.manuscriptContent is string && data.manuscriptContent.size() <= 300000)) &&
        (!data.keys().hasAny(['originalFileName']) || (data.originalFileName is string && data.originalFileName.size() <= 180)) &&
        (!data.keys().hasAny(['hasUploadedPdf']) || data.hasUploadedPdf is bool);
    }

    // Products: Public read for published metadata only; authenticated authors manage their own volumes
    match /products/{productId} {
      allow get: if isValidId(productId) && (
        existing().isPublished == true ||
        (isSignedIn() && existing().ownerId == request.auth.uid)
      );
      allow list: if existing().isPublished == true ||
        (isSignedIn() && existing().ownerId == request.auth.uid);
      allow create: if isValidId(productId) && isSignedIn() && isValidProduct(incoming());
      allow update: if isValidId(productId) && isSignedIn() &&
        isValidProduct(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'slug',
          'subtitle',
          'description',
          'shortDescription',
          'author',
          'language',
          'category',
          'coverImage',
          'priceBDT',
          'priceUSD',
          'format',
          'fileSize',
          'pages',
          'isbn',
          'publishedYear',
          'keyTakeaways',
          'sampleChapters',
          'isPublished',
          'updatedAt'
        ]);
      allow delete: if isValidId(productId) && isSignedIn() && existing().ownerId == request.auth.uid;

      // Private Manuscript Subcollection: Master Gate enforces parent product ownerId
      match /private/{docId} {
        allow get: if isValidId(productId) && isValidId(docId) && isSignedIn() &&
          get(/databases/$(database)/documents/products/$(productId)).data.ownerId == request.auth.uid;
        allow list: if false;
        allow create: if isValidId(productId) && isValidId(docId) && isSignedIn() &&
          isValidPrivateManuscript(incoming()) &&
          get(/databases/$(database)/documents/products/$(productId)).data.ownerId == request.auth.uid;
        allow update: if isValidId(productId) && isValidId(docId) && isSignedIn() &&
          isValidPrivateManuscript(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          get(/databases/$(database)/documents/products/$(productId)).data.ownerId == request.auth.uid;
        allow delete: if isValidId(productId) && isValidId(docId) && isSignedIn() &&
          get(/databases/$(database)/documents/products/$(productId)).data.ownerId == request.auth.uid;
      }
    }

    // Users: Customers can read, register, and update their optional profile fields only
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().role == existing().role &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'penName',
          'phone',
          'location',
          'bio',
          'website',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Orders: Customers can read only their own orders; writes are server-only
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Payments: Read by order owner only; written by server only
    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && isSignedIn() &&
        get(/databases/$(database)/documents/orders/$(existing().orderId)).data.userId == request.auth.uid;
      allow list: if false;
      allow write: if false;
    }

    // Downloads: Read by entitled owner only; written by server only
    match /downloads/{downloadId} {
      allow get: if isValidId(downloadId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow write: if false;
    }

    // Coupons: Public read for active codes only; writes disabled from client SDKs
    match /coupons/{couponId} {
      allow get: if isValidId(couponId) && existing().isActive == true;
      allow list: if existing().isActive == true;
      allow write: if false;
    }
  }
}
