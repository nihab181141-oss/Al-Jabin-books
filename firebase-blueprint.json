{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Public storefront metadata for published ebooks (private manuscripts and full PDFs are isolated in subcollections and server storage)",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the publication", "maxLength": 180 },
        "slug": { "type": "string", "description": "URL-friendly slug", "maxLength": 200 },
        "subtitle": { "type": "string", "description": "Optional book subtitle", "maxLength": 240 },
        "description": { "type": "string", "description": "Detailed book synopsis", "maxLength": 5000 },
        "shortDescription": { "type": "string", "description": "Summary blurb", "maxLength": 600 },
        "author": { "type": "string", "description": "Author or pen name", "maxLength": 120 },
        "language": { "type": "string", "description": "Language of edition", "maxLength": 60 },
        "category": {
          "type": "string",
          "enum": ["Personal Growth", "Mindset", "Productivity", "Fiction"],
          "description": "Literary or knowledge category"
        },
        "coverImage": { "type": "string", "description": "Cover artwork URL or compressed data URL", "maxLength": 250000 },
        "priceBDT": { "type": "number", "description": "Price in Bangladeshi Taka (0 for free)" },
        "priceUSD": { "type": "number", "description": "Optional price in USD" },
        "format": { "type": "string", "description": "Edition format (e.g., PDF & EPUB)", "maxLength": 60 },
        "fileSize": { "type": "string", "description": "Digital file size label", "maxLength": 40 },
        "pages": { "type": "number", "description": "Estimated or actual page count" },
        "isbn": { "type": "string", "description": "Catalogue ID or ISBN", "maxLength": 64 },
        "publishedYear": { "type": "number", "description": "Year of publication" },
        "keyTakeaways": { "type": "array", "description": "List of core takeaways (max 10)" },
        "sampleChapters": { "type": "array", "description": "Public preview chapter excerpts (max 5)" },
        "originalFileStoragePath": { "type": "string", "description": "Server/Storage key reference (no direct public read)", "maxLength": 256 },
        "previewFileStoragePath": { "type": "string", "description": "Public sample excerpt path", "maxLength": 256 },
        "isPublished": { "type": "boolean", "description": "Publication availability status" },
        "isFeatured": { "type": "boolean", "description": "Featured shelf status" },
        "isNewRelease": { "type": "boolean", "description": "New release flag" },
        "ownerId": { "type": "string", "description": "Firebase Auth UID of publishing author", "maxLength": 128 },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation", "maxLength": 64 },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update", "maxLength": 64 }
      },
      "required": ["title", "author", "category", "priceBDT", "isPublished", "ownerId", "createdAt"]
    },
    "PrivateManuscript": {
      "title": "PrivateManuscript",
      "description": "Restricted author-only manuscript text and private PDF metadata (never publicly readable)",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "description": "Firebase Auth UID of owning author", "maxLength": 128 },
        "manuscriptContent": { "type": "string", "description": "Full private ebook text", "maxLength": 300000 },
        "originalFileName": { "type": "string", "description": "Uploaded PDF/text filename", "maxLength": 180 },
        "hasUploadedPdf": { "type": "boolean", "description": "Whether a binary PDF was uploaded to protected server storage" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update", "maxLength": 64 }
      },
      "required": ["ownerId", "updatedAt"]
    },
    "User": {
      "title": "User",
      "description": "Private reader and independent author account profile (strictly owner-readable)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID", "maxLength": 128 },
        "displayName": { "type": "string", "description": "Full name (optional)", "maxLength": 120 },
        "penName": { "type": "string", "description": "Author / pen name (optional)", "maxLength": 120 },
        "email": { "type": "string", "description": "Account email address", "maxLength": 320 },
        "phone": { "type": "string", "description": "Phone or WhatsApp number (optional)", "maxLength": 40 },
        "location": { "type": "string", "description": "City or country (optional)", "maxLength": 120 },
        "bio": { "type": "string", "description": "Short author/reader bio (optional)", "maxLength": 500 },
        "website": { "type": "string", "description": "Personal website or social URL (optional)", "maxLength": 256 },
        "role": { "type": "string", "enum": ["customer"], "description": "Account role" },
        "createdAt": { "type": "string", "description": "ISO timestamp of registration", "maxLength": 64 },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update", "maxLength": 64 }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase transaction for digital volumes (server-only writes)",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "description": "Unique order reference" },
        "userId": { "type": "string", "description": "Buyer user UID" },
        "customerName": { "type": "string", "description": "Full name of buyer" },
        "customerEmail": { "type": "string", "description": "Buyer verified email address" },
        "customerPhone": { "type": "string", "description": "Buyer contact phone number" },
        "items": { "type": "array", "description": "Validated order line items" },
        "subtotal": { "type": "number", "description": "Subtotal before discounts" },
        "discount": { "type": "number", "description": "Discount applied from coupons" },
        "total": { "type": "number", "description": "Final server-calculated charge" },
        "currency": { "type": "string", "enum": ["BDT", "USD"], "description": "Order currency" },
        "paymentProvider": { "type": "string", "enum": ["direct"], "description": "Payment channel" },
        "paymentStatus": { "type": "string", "enum": ["pending", "verified", "failed", "cancelled"], "description": "Payment verification state" },
        "fulfillmentStatus": { "type": "string", "enum": ["pending", "fulfilled", "failed"], "description": "Digital delivery state" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "paidAt": { "type": "string", "description": "ISO timestamp when payment was validated" },
        "deliveredAt": { "type": "string", "description": "ISO timestamp when digital access was granted" }
      },
      "required": ["orderNumber", "customerEmail", "total", "currency", "paymentStatus", "fulfillmentStatus"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Server-side payment verification log (server-only writes)",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "description": "Referenced order ID" },
        "provider": { "type": "string", "description": "Payment gateway provider name" },
        "providerTransactionId": { "type": "string", "description": "Unique transaction identity from provider" },
        "amount": { "type": "number", "description": "Amount charged" },
        "currency": { "type": "string", "description": "Currency used" },
        "status": { "type": "string", "description": "Provider response status" },
        "validationStatus": { "type": "string", "enum": ["VALID", "FAILED", "PENDING"], "description": "Server API validation result" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "validatedAt": { "type": "string", "description": "Validation timestamp" }
      },
      "required": ["orderId", "provider", "amount", "currency", "validationStatus"]
    },
    "Download": {
      "title": "Download",
      "description": "Secure, tokenized digital ebook delivery entitlement (server-only writes)",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "description": "Associated verified order" },
        "userId": { "type": "string", "description": "Entitled user UID if registered" },
        "customerEmail": { "type": "string", "description": "Entitled customer email" },
        "productId": { "type": "string", "description": "Purchased publication ID" },
        "tokenHash": { "type": "string", "description": "Opaque access token" },
        "expiresAt": { "type": "string", "description": "ISO timestamp when link expires" },
        "downloadCount": { "type": "number", "description": "Times accessed" },
        "maxDownloads": { "type": "number", "description": "Maximum allowed downloads" },
        "createdAt": { "type": "string", "description": "Timestamp created" },
        "revokedAt": { "type": "string", "description": "Optional revocation timestamp" }
      },
      "required": ["orderId", "customerEmail", "productId", "tokenHash", "expiresAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount codes (server-only writes)",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "Uppercase coupon code" },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"], "description": "Type of discount" },
        "discountValue": { "type": "number", "description": "Discount amount or percentage" },
        "minimumOrderValue": { "type": "number", "description": "Minimum subtotal required" },
        "usageLimit": { "type": "number", "description": "Maximum total uses permitted" },
        "usageCount": { "type": "number", "description": "Times redeemed" },
        "isActive": { "type": "boolean", "description": "Coupon status" }
      },
      "required": ["code", "discountType", "discountValue", "isActive"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public storefront catalogue metadata for published publications"
    },
    "/products/{productId}/private/{docId}": {
      "schema": "PrivateManuscript",
      "description": "Strictly private author manuscript text and file references isolated from public reads"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Customer and author private profile records"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders and status records"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Validated payment transaction records"
    },
    "/downloads/{downloadId}": {
      "schema": "Download",
      "description": "Secure digital book download entitlement tokens"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Store promo and discount codes"
    }
  }
}
