rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Public book covers and sample reading excerpts
    match /covers/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /samples/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Original, unencrypted master ebook files: STRICTLY PRIVATE
    // Download access is only granted via backend server stream
    match /ebooks/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
