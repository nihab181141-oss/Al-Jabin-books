rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin'
      );
    }

    // Public book covers and sample reading excerpts
    match /covers/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /samples/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Original, unencrypted master ebook files: STRICTLY PRIVATE
    // Download access is only granted via backend signed URLs or server proxy stream
    match /ebooks/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
